#!/usr/bin/env python3
"""Check MANUAL.md against the commands as they actually are.

Developer tool. Runs in the CI gate: no model call, no network — it asks each
command for its `--help-json` manifest, which is deterministic, and compares
the *names* the manual uses with the names the CLI has.

Prose is not checked, and neither is wording or order. Three things are:

  subcommands   every subcommand exists, and every subcommand is documented
  flags         every flag the manual names exists, and every flag exists in
                the manual (`--help` and `--help-json` are meta and exempt)
  scope         a command's section documents that command only

The manual is generated by a model (`dev/ci manual`), so nothing here can
regenerate it. What this does is fail loudly when the committed manual has
drifted from the code — the failure mode round 3 was meant to close, and the
manual is what an agent reads.

Usage:
    dev/manual-check [--manual MANUAL.md]
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / 'dev'))
from commands import COMMANDS  # noqa: E402

# Documented once in the manual's own preamble, not per command.
EXEMPT_FLAGS = {'--help', '-h', '--help-json'}

# `| `name` | ...` — the first cell of a table row, where the manual lists a
# subcommand or a flag.
ROW_RE = re.compile(r'^\|\s*`([^`]+)`\s*\|')
# Any `code span` in the section.
CODE_RE = re.compile(r'`([^`]+)`')
FLAG_RE = re.compile(r'--[a-z][a-z0-9-]*')


def manifest(tool):
    """The tool's own description of its surface."""
    exe = REPO / '.venv' / 'bin' / tool
    env = dict(os.environ)
    env.pop('ADULTING_HOME', None)
    p = subprocess.run([str(exe), '--help-json'], capture_output=True, text=True,
                       env=env, stdin=subprocess.DEVNULL, timeout=20)
    if p.returncode != 0:
        sys.exit(f"manual-check: error: {tool} --help-json failed: {p.stderr.strip()}")
    return json.loads(p.stdout)


def spellings(flag):
    """Every way a flag can be written, longest first, so a message about it
    names `--minutes` rather than `-m`."""
    return sorted([flag['name']] + flag.get('aliases', []), key=len, reverse=True)


def real_names(m):
    """(subcommands, flags) the command really has. A flag is the set of its
    spellings: documenting either one documents the flag."""
    subs = {s['name'] for s in m.get('subcommands', [])}
    flags = [f for f in m.get('flags', [])]
    for s in m.get('subcommands', []):
        flags += s.get('flags', [])
    spelt = {tuple(spellings(f)) for f in flags}
    return subs, sorted(s for s in spelt if not set(s) & EXEMPT_FLAGS)


def sections(manual_text):
    """{command: its section's text}, from the `### \\`name\\`` headings.

    A section ends at the next heading of any level, so the last command does
    not swallow the chapters that follow it.
    """
    parts = re.split(r'^### `([a-z]+)`$', manual_text, flags=re.M)
    out = {}
    for i in range(1, len(parts), 2):
        body = re.split(r'^#{1,3} ', parts[i + 1], maxsplit=1, flags=re.M)[0]
        out[parts[i]] = body
    return out


def claimed_names(text):
    """(subcommands, flags) the section formally documents: the first cell of
    a table row, which is where the manual lists each one. Prose is not read
    for claims — only for whether something real was mentioned at all.

    Subcommands are read from the **Subcommands** table alone, so the
    positional arguments listed in an **Arguments** table are not mistaken
    for subcommands.
    """
    subs, flags = set(), set()
    heading = ''
    for line in text.splitlines():
        if line.startswith('**') and line.rstrip().endswith('**'):
            heading = line.strip('* ')
            continue
        row = ROW_RE.match(line)
        if not row:
            continue
        cell = row.group(1)
        found = FLAG_RE.findall(cell)
        flags |= set(found)
        if not found and heading == 'Subcommands' and re.fullmatch(r'[a-z][a-z-]*', cell):
            subs.add(cell)
    return subs, flags - EXEMPT_FLAGS


def problems(tool, text):
    subs, flags = real_names(manifest(tool))
    said_subs, said_flags = claimed_names(text)
    every_spelling = {s for spelt in flags for s in spelt}
    out = []
    for name in sorted(said_subs - subs):
        out.append(f"documents `{tool} {name}`, which does not exist")
    for name in sorted(subs - said_subs):
        out.append(f"does not document the subcommand `{name}`")
    for name in sorted(said_flags - every_spelling):
        out.append(f"documents the flag `{name}`, which does not exist")
    for spelt in sorted(flags):
        if not any(s in text for s in spelt):
            out.append(f"does not document the flag `{spelt[0]}`")
    return sorted(out)


def main():
    ap = argparse.ArgumentParser(description="Check MANUAL.md against the CLI.")
    ap.add_argument('--manual', default=str(REPO / 'MANUAL.md'))
    args = ap.parse_args()

    manual = Path(args.manual)
    if not manual.exists():
        sys.exit(f"manual-check: error: no manual at {manual}")
    found = sections(manual.read_text(encoding='utf-8'))

    failed = False
    for tool in COMMANDS:
        if tool not in found:
            print(f"{tool}: no `### `{tool}`` section in the manual")
            failed = True
            continue
        for problem in problems(tool, found[tool]):
            print(f"{tool}: {problem}")
            failed = True
    if failed:
        print("\nThe manual is stale. Regenerate it with `dev/ci manual`, "
              "which needs `claude`.")
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
