#!/bin/bash

# --help-json: emit a structured manifest for agent-build. Hand-maintained
# (this is a bash dispatcher; no argparse to introspect). Keep in sync
# with the case statement at the bottom of the file.
if [ "$1" = "--help-json" ]; then
cat <<'EOF'
{
  "name": "notes",
  "description": "Dispatcher for note operations: create, render, edit, query.",
  "args": [
    {"name": "subcommand", "description": "One of the named operations below.", "required": false, "nargs": null},
    {"name": "filter", "description": "Optional substring filter for the picker (case-insensitive).", "required": false, "nargs": null}
  ],
  "subcommands": [
    {"name": "new", "description": "Create a new note (interactive — TTY only)."},
    {"name": "copy", "description": "Pick a note, copy contents to a new timestamp (interactive)."},
    {"name": "strip", "description": "Pick a note, copy and remove body — for templating (interactive)."},
    {"name": "edit", "description": "Pick a note, open in the default editor (interactive)."},
    {"name": "nano", "description": "Pick a note, open in nano (interactive)."},
    {"name": "last", "description": "Open the most recently-created note."},
    {"name": "delete", "description": "Pick a note and permanently delete (interactive)."},
    {"name": "cat", "description": "Pick a note and print to stdout."},
    {"name": "pdf", "description": "Pick a note and render to PDF + markdown."},
    {"name": "minutes", "description": "Render meeting minutes (TOC + AGREED/RESOLVED/ACTION summary)."},
    {"name": "agenda", "description": "Render meeting agenda."}
  ]
}
EOF
exit 0
fi

ADULTING_HOME="${ADULTING_HOME:-$HOME/.adulting}"
NOTES_DIR="$ADULTING_HOME/notes"
THREAD_DIR="$ADULTING_HOME/threads"
PEOPLE_DIR="$ADULTING_HOME/people"
EXPORT_DIR="$HOME/Downloads"



# Check if the directory exists, if not, create it
if [ ! -d "$NOTES_DIR" ]; then
    mkdir -p "$NOTES_DIR"
fi


# Function to display help text
display_help() {
    cat << EOF

Usage: $0 <subcommand> [filter]
Example: $0 new

CREATION:
    new        [DEFAULT] Create a new note and open it for editing.
    copy       Select a note, copy contents to a new note with the current timestamp.
    strip      Select a note, copy contents and remove the body — useful as a template.

MODIFICATION:
    edit       Select a note, open in default editor.
                   Special keywords you can use in the body:
                       "ACTION:"   Action item — ingested into the backend by \`tasks\` on next invocation.
                       "TASK:"     Already-ingested action item (set by \`tasks\`; do not write by hand).
                       "AGREED:"   Statement the meeting formally agrees on.
                       "RESOLVED:" Statement the meeting resolves.
                       "!:"        Important callout, surfaced in \`notes pdf\` summary section.
    nano       Edit in nano (CLI editor) instead.
    last       Open the most recently-created note.

DELETION:
    delete     Select a note and permanently delete it.

RENDERING (output to \$EXPORT_DIR, default ~/Downloads):
    cat        Print the note to stdout (pipeable).
    pdf        Render note as PDF + markdown with a summary of ACTION/TASK lines.
    minutes    Render meeting minutes (TOC, AGREED:/RESOLVED:/ACTION: summary).
    agenda     Render meeting agenda.

Optional second argument: filter the picker list with grep (case-insensitive).

EOF
}



# FUNCTIONS
# Select note
select_note() {
    echo "$notes_all" | awk 'BEGIN{FS="|"} {print $1, "|", $3, "|", $4, "|", $5, "|", $6}' | column -t -s "|"
    echo "Which note do you want to select?"
    read note_number
    note_number="$note_number"p
    selected_note=$(echo $(echo "$notes_unfiltered" | sed -n "$note_number" | awk 'BEGIN{FS="|"} {print $2}'))
    echo $selected_note
}

# Open  note
open_note() {
    local encoded
    encoded=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$note")
    local uri="obsidian://open?path=$encoded"
    if [[ $(uname) == "Linux" ]]; then
        xdg-open "$uri"
    elif [[ $(uname) == "Darwin" ]]; then
        open "$uri"
    else
        echo "Unsupported operating system"
    fi
}

# Nano  note
nano_note() {
    # Check the operating system
    if [[ $(uname) == "Linux" ]]; then
        nano -"$@" note
        #open -g $note
    elif [[ $(uname) == "Darwin" ]]; then
        nano "$@" note
        #open -g $note
    else
        # If it's neither Linux nor macOS, print an error message
        echo "Unsupported operating system"
    fi
}

# Read the YAML `threads:` list out of a note's frontmatter, one entry
# per stdout line. Wikilinks `[[Kind/Name]]` are unwrapped to `Kind/Name`.
# Falls back to a singular `thread:` field (used by log files) if
# `threads:` is absent.
extract_threads_list() {
    local file="$1"
    awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function strip_quotes(s,    n, c) {
        n = length(s)
        if (n < 2) return s
        c = substr(s, 1, 1)
        if ((c == "\"" && substr(s, n, 1) == "\"") || (c == "'\''" && substr(s, n, 1) == "'\''")) {
            return substr(s, 2, n - 2)
        }
        return s
    }
    function unwiki_thread(s,   tmp) {
        tmp = s
        if (sub(/^\[\[/, "", tmp) > 0 && sub(/\]\]$/, "", tmp) > 0) return tmp
        return s
    }
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    !in_fm { next }
    in_list && /^[^[:space:]]/ { in_list = 0 }
    in_list && /^[[:space:]]+- / {
        v = $0
        sub(/^[[:space:]]+-[[:space:]]+/, "", v)
        v = trim(v)
        v = strip_quotes(v)
        v = unwiki_thread(v)
        print v
        next
    }
    /^threads:[[:space:]]*$/ { in_list = 1; next }
    /^thread:[[:space:]]+/ {
        v = $0
        sub(/^thread:[[:space:]]+/, "", v)
        v = trim(v)
        v = strip_quotes(v)
        v = unwiki_thread(v)
        print v
    }
    ' "$file"
}

# Read the YAML `people:` list out of a note's frontmatter, one entry per
# stdout line. Wikilinks `[[people/Name]]` are unwrapped to bare names;
# plain string entries are returned as-is.
extract_people_list() {
    local file="$1"
    awk '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function strip_quotes(s,    n, c) {
        n = length(s)
        if (n < 2) return s
        c = substr(s, 1, 1)
        if ((c == "\"" && substr(s, n, 1) == "\"") || (c == "'\''" && substr(s, n, 1) == "'\''")) {
            return substr(s, 2, n - 2)
        }
        return s
    }
    function unwiki_people(s,   tmp) {
        tmp = s
        if (sub(/^\[\[people\//, "", tmp) > 0 && sub(/\]\]$/, "", tmp) > 0) return tmp
        return s
    }
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    !in_fm { next }
    in_list && /^[^[:space:]]/ { in_list = 0 }
    in_list && /^[[:space:]]+- / {
        v = $0
        sub(/^[[:space:]]+-[[:space:]]+/, "", v)
        v = trim(v)
        v = strip_quotes(v)
        v = unwiki_people(v)
        print v
        next
    }
    /^people:[[:space:]]*$/ { in_list = 1; next }
    ' "$file"
}

# Read a metadata field from a YAML frontmatter block in a note.
# Strips surrounding single/double YAML quotes from the value when present.
extract_meta() {
    local field="$1"
    local file="$2"
    awk -v want="$field" '
    function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
    function unquote(s,    n, c) {
        n = length(s)
        if (n < 2) return s
        c = substr(s, 1, 1)
        if (c == "\"" && substr(s, n, 1) == "\"") {
            s = substr(s, 2, n - 2)
            gsub(/\\"/, "\"", s)
            gsub(/\\\\/, "\\", s)
        } else if (c == "'\''" && substr(s, n, 1) == "'\''") {
            s = substr(s, 2, n - 2)
            gsub(/'\'\''/, "'\''", s)
        }
        return s
    }
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    in_fm {
        pos = index($0, ":")
        if (pos == 0) next
        key = trim(substr($0, 1, pos-1))
        if (key == want) { print unquote(trim(substr($0, pos+1))); exit }
    }
    ' "$file"
}

# EXPORTS
# Export variables
export NOTES_DIR
export THREAD_DIR
export PEOPLE_DIR
export EXPORT_DIR

# Export functions
export -f open_note
export -f extract_meta
export -f extract_people_list
export -f extract_threads_list


subcommand="${1:-new}"

# NEW NOTE — no pre-pass, no notes-list build needed.
if [[ "$subcommand" = "new" ]]; then
    notes_new
    exit
fi

# Ingest any new ACTION: lines into taskwarrior. Tasks invocation is
# tolerant of taskwarrior not being installed if there's nothing to ingest.
tasks --quiet 2>/dev/null || true

# GET NOTES LIST
for f in $NOTES_DIR/*.md
    do
        filenum=$((filenum+1))
        note_info=$filenum
        note_info+="|"
        note_info+=$(basename $f)
        note_info+="|"
        note_info+=$(extract_meta timestamp "$f" | cut -c 1-10)
        note_info+="|"
        note_info+=$(extract_threads_list "$f" | paste -sd ',' -)
        note_info+="|"
        note_info+=$(extract_meta type "$f")
        note_info+="|"
        note_info+=$(extract_meta topic "$f")
        notes_unfiltered="${notes_unfiltered}"$'\n'"${note_info}"
    done

# Remove the first newline
notes_unfiltered=${notes_unfiltered:1}

# Sort notes by timestamp (column 3)
notes_unfiltered=$(echo "$notes_unfiltered" | sort -t '|' -k3)

# Renumber the first column after sorting
notes_unfiltered=$(echo "$notes_unfiltered" | awk -F'|' '{$1=NR; print}' OFS='|')

if [ ! -z "$2" ]; then
  notes_all=$(echo "$notes_unfiltered" | grep -i "$2" | awk -F  "/" 'tolower($0) ~ /1/ {print $NF}')
else
  notes_all="$notes_unfiltered"
fi

case "$subcommand" in
    last)
        last_note=$(echo "$notes_all" | tail -n 1 | awk 'BEGIN{FS="|"} {print $2}')
        note="$NOTES_DIR/$last_note"
        open_note $note
        ;;

    minutes)
        select_note
        notes_minutes $selected_note
        ;;

    agenda)
        select_note
        notes_agenda $selected_note
        ;;

    pdf)
        select_note
        notes_pdf $selected_note
        ;;

    delete)
        select_note
        note="$NOTES_DIR/$selected_note"
        rm $note
        ;;

    edit)
        select_note
        note="$NOTES_DIR/$selected_note"
        open_note $note
        ;;

    nano)
        select_note
        note="$NOTES_DIR/$selected_note"
        nano_note $note
        ;;

    cat)
        select_note
        note="$NOTES_DIR/$selected_note"
        cat $note
        ;;

    copy)
        select_note
        note="$NOTES_DIR/$selected_note"
        dt=$(date '+%Y-%m-%d-%H-%M-%S')
        new_note="$NOTES_DIR/$dt.md"
        cp $note $new_note
        sed -i '' '/^topic:/s/$/ COPY/' $new_note
        echo "Copied $selected_note to $dt.md"
        ;;

    strip)
        select_note
        note="$NOTES_DIR/$selected_note"
        dt=$(date '+%Y-%m-%d-%H-%M-%S')
        new_note="$NOTES_DIR/$dt.md"
        cp $note $new_note
        sed -i '' '/^topic:/s/$/ STRIPPED/' $new_note
        echo "Copied $selected_note to $dt.md"
        echo "Stripping $dt.md"
        notes_strip $dt.md
        ;;

    *)
        display_help
        ;;
esac
