#!/bin/bash

: "${NOTES_DIR:?must be invoked via 'notes', not directly}"

selected_note=$1
note="$NOTES_DIR/$selected_note"
tempfile=$(mktemp)

# Copy YAML frontmatter verbatim, then keep only headers/separators from the body.
awk '
BEGIN { in_fm = 0 }
NR == 1 && /^---$/ { in_fm = 1; print; next }
in_fm && /^---$/ { print; in_fm = 0; next }
in_fm { print; next }
/^#/ || /^---/ { print ""; print }
' "$note" > "$tempfile"

mv "$tempfile" "$note"
