#!/usr/bin/env python3
"""Bridge ACTION: lines from notes into taskwarrior.

For each line `ACTION: [(Assignee)] description` in any note body:
  1. Resolve the note's thread to a project name.
  2. Validate the assignee (if any) against ~/.adulting/people/.
  3. Run `task add project:<thread> [+<assignee>] <description>`.
  4. Rewrite the source line `ACTION:` -> `TASK:`.

Lines beginning `TASK:` are skipped (already ingested). Failures are
collected and printed; the source is left as `ACTION:` so the user can
fix and re-run.

`task` (taskwarrior) must be on PATH. The check is lazy — only errors
when there is something to ingest.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path(os.path.expanduser('~/.adulting'))
NOTES_DIR = HOME / 'notes'
THREADS_DIR = HOME / 'threads'
PEOPLE_DIR = HOME / 'people'

WIKILINK_RE = re.compile(r'\[\[([^\]]+)\]\]')
ACTION_RE = re.compile(r'^ACTION:\s*(?:\(([^)]+)\)\s*)?(.+?)\s*$')


def parse_frontmatter_thread(text):
    """Pull the bare wikilink target out of a note's `thread:` field.
    Returns the target string (e.g. 'Processes/SGB') or None."""
    lines = text.split('\n')
    if not lines or lines[0].strip() != '---':
        return None
    for line in lines[1:]:
        if line.strip() == '---':
            break
        m = re.match(r'^thread:\s*(.+?)\s*$', line)
        if m:
            val = m.group(1).strip().strip('"').strip("'")
            wm = WIKILINK_RE.match(val)
            if wm:
                return wm.group(1).strip()
            return val
    return None


def thread_to_project(target):
    """Convert a wikilink target like 'Processes/SGB' to a taskwarrior
    project string. We use the bare name (right of the slash). The kind
    prefix is implicit (it's the directory the file lives in)."""
    if '/' in target:
        return target.split('/', 1)[1]
    return target


def find_action_lines(note_path):
    """Yield (line_no, line_text, assignee, description) for every
    ACTION: line in this note's body."""
    text = note_path.read_text(encoding='utf-8')
    for idx, line in enumerate(text.split('\n'), start=1):
        m = ACTION_RE.match(line)
        if m:
            yield idx, line, (m.group(1) or '').strip(), m.group(2).strip()


def assignee_resolves(name):
    if not name:
        return True
    return (PEOPLE_DIR / f"{name}.md").exists()


def thread_resolves(target):
    if not target:
        return False
    if '/' not in target:
        return False
    kind_dir, name = target.split('/', 1)
    if kind_dir not in ('Projects', 'Processes', 'Topics'):
        return False
    return (THREADS_DIR / kind_dir / f"{name}.md").exists()


def rewrite_action_to_task(note_path, line_no):
    """In-place: change ACTION: at line_no to TASK: on the same line."""
    lines = note_path.read_text(encoding='utf-8').split('\n')
    idx = line_no - 1
    if idx < 0 or idx >= len(lines):
        return False
    if not lines[idx].startswith('ACTION:'):
        return False
    lines[idx] = 'TASK:' + lines[idx][len('ACTION:'):]
    note_path.write_text('\n'.join(lines), encoding='utf-8')
    return True


def main():
    parser = argparse.ArgumentParser(description="Ingest ACTION: lines from notes into taskwarrior.")
    parser.add_argument('--dry-run', action='store_true',
                        help="Show what would be ingested; don't call task or rewrite files.")
    parser.add_argument('--quiet', action='store_true',
                        help="Suppress per-action output; just summary + errors.")
    args = parser.parse_args()

    if not NOTES_DIR.is_dir():
        return 0

    plan = []  # (note_path, line_no, project, assignee, description, errors)
    for note in sorted(NOTES_DIR.iterdir()):
        if note.suffix != '.md' or note.name.startswith('.'):
            continue
        text = note.read_text(encoding='utf-8')
        thread_target = parse_frontmatter_thread(text)
        for line_no, line, assignee, description in find_action_lines(note):
            errors = []
            if not description:
                errors.append("missing description")
            if not thread_target:
                errors.append("note has no thread:")
            elif not thread_resolves(thread_target):
                errors.append(f"thread {thread_target!r} does not resolve")
            if assignee and not assignee_resolves(assignee):
                errors.append(f"assignee {assignee!r} does not resolve to people/{assignee}.md")
            project = thread_to_project(thread_target) if thread_target else None
            plan.append((note, line_no, project, assignee, description, errors))

    if not plan:
        return 0

    # Lazy PATH check.
    if shutil.which('task') is None:
        print("error: 'task' (taskwarrior) not in PATH; install it or remove the ACTION: lines.", file=sys.stderr)
        return 2

    succeeded = 0
    failed = []
    for note, line_no, project, assignee, description, errors in plan:
        prefix = f"{note}:{line_no}"
        if errors:
            failed.append((prefix, errors))
            continue
        # Build `task add` invocation.
        cmd = ['task', 'add']
        # project: with quoting handled by argv
        if project:
            cmd.append(f'project:{project}')
        if assignee:
            # Prepend the assignee in parens to the description so it's
            # visible in `task list`. Could also use a tag, but the
            # convention so far is parens in the text.
            full_desc = f'({assignee}) {description}'
        else:
            full_desc = description
        cmd.append(full_desc)

        if args.dry_run:
            if not args.quiet:
                print(f"would: {' '.join(repr(a) if ' ' in a else a for a in cmd)}")
            continue

        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as e:
            failed.append((prefix, [f"task add failed: {e.stderr.strip() or e.stdout.strip()}"]))
            continue

        rewrite_action_to_task(note, line_no)
        succeeded += 1
        if not args.quiet:
            short = description[:60] + ('...' if len(description) > 60 else '')
            print(f"ingested: {prefix}  project:{project}  {short}")

    if failed:
        print()
        print(f"{len(failed)} action(s) NOT ingested (left as ACTION: in source):", file=sys.stderr)
        for prefix, errs in failed:
            for e in errs:
                print(f"  {prefix}: {e}", file=sys.stderr)
        print()

    if not args.quiet:
        print(f"Ingested: {succeeded}.  Failed: {len(failed)}.  Total: {len(plan)}.")

    return 0 if not failed else 1


if __name__ == '__main__':
    sys.exit(main())
