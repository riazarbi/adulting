#!/usr/bin/env python3
"""Bridge ACTION: lines from notes into the task backend; keep source
TASK:/DONE: lines in sync with backend state. Surface backend operations
as opinionated subcommands so the backend stays internal.

No-arg invocation (used as a pre-pass by `notes`):
  1. Configure the `source` UDA on the backend if not already (idempotent).
  2. Ingest ACTION: lines from notes into the backend, anchoring the source
     line back with an 8-char UUID HTML comment.
  3. Sync source <-> backend:
     - Description drift (source body != backend description): source wins.
     - Status drift: completed-state-wins.

Subcommands:
  install                        set up the embedded backend (one-shot)
  add <thread> <text>            buffer-append a structured ACTION
  done <uuid>                    flip source TASK->DONE; mark backend done
  set-description <uuid> <text>  rewrite source body; sync pushes to backend
  set-assignee <uuid> <person>   rewrite source (Asg) prefix
  set-due <uuid> <YYYY-MM-DD>    set due date
  set-scheduled <uuid> <YYYY-MM-DD>  set scheduled date
  set-priority <uuid> <H|M|L>    set priority
  add-depends <uuid> <dep>       add a depends entry
  rm-depends <uuid> <dep>        remove a depends entry
  list [filter...]               formatted list with UUID prefix
  next                           top of queue
  show <uuid>                    detail view

Run `tasks install` once after cloning; everything thereafter goes through
this CLI.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _argparse_helpjson import emit_helpjson_if_requested  # noqa: E402

HOME = Path(os.environ.get('ADULTING_HOME', os.path.expanduser('~/.adulting')))
NOTES_DIR = HOME / 'notes'
THREADS_DIR = HOME / 'threads'
PEOPLE_DIR = HOME / 'people'
LOGS_DIR = HOME / 'logs'
BUFFER_FILE = HOME / 'buffer.md'

# Internal/operational state lives in a hidden subdir alongside the user
# content, the same way .git and .obsidian do. Keeps the visible top
# level limited to vault content (notes/, threads/, people/, logs/,
# buffer.md) so file browsers and Obsidian don't show tooling cruft.
INTERNAL_DIR = HOME / '.adulting'
CONFIG_FILE = INTERNAL_DIR / 'config.yaml'
TASK_BIN = INTERNAL_DIR / 'bin' / 'task'
TASK_DATA = INTERNAL_DIR / 'task-data'
TASK_RC = INTERNAL_DIR / 'taskrc'

# Legacy (pre-2026-05-19) layout had these at HOME directly. Kept for
# detection so we can route the user to `tasks migrate-layout` instead
# of the wrong-looking "run tasks install" message.
_LEGACY_TASK_BIN = HOME / 'bin' / 'task'
_LEGACY_TASK_DATA = HOME / 'task-data'
_LEGACY_TASK_RC = HOME / 'taskrc'
_LEGACY_CONFIG_FILE = HOME / 'config.yaml'

WIKILINK_RE = re.compile(r'\[\[([^\]]+)\]\]')
# ACTION line shape (in notes/ or logs/): optional (Person), description,
# and optional trailing HTML comment carrying ingest-time attrs.
ACTION_RE = re.compile(
    r'^ACTION:\s*(?:\(([^)]+)\)\s*)?(.+?)(?:\s*<!--(.*?)-->)?\s*$'
)
# Post-ingest anchor in source: TASK (pending) or DONE (completed) line
# ending with <!--<uuid8>-->. Groups: 1=kind, 2=body, 3=uuid8. Used by
# `tasks rebuild` to reconcile tw against source-of-truth.
TASK_ANCHOR_RE = re.compile(
    r'^(TASK|DONE):\s(.*?)\s*<!--([a-f0-9]{8})-->\s*$',
    re.MULTILINE,
)
DATE_RE = re.compile(r'^\d{4}-\d{2}-\d{2}$')
ASSIGNEE_PREFIX_RE = re.compile(r'^\(([^)]+)\)\s*(.*)$')


# ---------- helpers ----------

def task_installed():
    return TASK_BIN.exists()


def _on_legacy_layout():
    """True when the legacy (pre-.adulting/ subdir) backend is present at
    HOME directly but the new INTERNAL_DIR version isn't. Used to give a
    targeted error instead of the generic 'run tasks install' message."""
    return _LEGACY_TASK_BIN.exists() and not TASK_BIN.exists()


def require_task():
    if task_installed():
        return
    if _on_legacy_layout():
        die("legacy layout detected; run `tasks migrate-layout` to relocate "
            "the embedded backend into .adulting/")
    die(f"embedded backend not installed at {TASK_BIN}; run `tasks install`")


def task_cmd(*args):
    """Build argv for the embedded binary. Always pair with env=task_env()
    on the subprocess call so TASKDATA/TASKRC point at our private dirs."""
    return [str(TASK_BIN), *args]


def task_env():
    """Env that pins the embedded backend at its private data dir + rcfile,
    isolated from any global install the user may also have."""
    env = dict(os.environ)
    env['TASKDATA'] = str(TASK_DATA)
    env['TASKRC'] = str(TASK_RC)
    return env


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def validate_date(s):
    """Caller-format YYYY-MM-DD. Returns the same string if valid;
    raises ValueError otherwise. taskwarrior accepts this form natively
    so no conversion is needed at the boundary."""
    if not DATE_RE.match(s):
        raise ValueError(f"date must be YYYY-MM-DD, got {s!r}")
    try:
        datetime.strptime(s, '%Y-%m-%d')
    except ValueError as e:
        raise ValueError(f"invalid date {s!r}: {e}")
    return s


def validate_priority(s):
    if s not in ('H', 'M', 'L'):
        raise ValueError(f"priority must be H, M, or L; got {s!r}")
    return s


def assignee_resolves(name):
    if not name:
        return True
    return (PEOPLE_DIR / f"{name}.md").exists()


def thread_resolves(target):
    if not target or '/' not in target:
        return False
    kind_dir, name = target.split('/', 1)
    if kind_dir not in ('Projects', 'Processes', 'Topics'):
        return False
    return (THREADS_DIR / kind_dir / f"{name}.md").exists()


def discover_source_files():
    """Yield .md files from both notes/ (flat) and logs/ (recursive). These
    are the input domains for ACTION lines / TASK anchors. Skips dotfiles."""
    if NOTES_DIR.is_dir():
        for f in sorted(NOTES_DIR.iterdir()):
            if f.suffix == '.md' and not f.name.startswith('.'):
                yield f
    if LOGS_DIR.is_dir():
        for root, dirs, files in os.walk(LOGS_DIR):
            dirs[:] = [d for d in dirs if not d.startswith('.')]
            for fname in sorted(files):
                if fname.endswith('.md') and not fname.startswith('.'):
                    yield Path(root) / fname


def source_for(path):
    """Compute the `source:` UDA value: relative path from HOME, no .md.
    e.g. 'notes/2026-05-07-09-15-22' or 'logs/Projects/SGB/2026-05-07'."""
    return str(path.relative_to(HOME).with_suffix(''))


# ---------- taskwarrior modify wrapper ----------

# Field names that `task modify` accepts as `attr:value` updates. Lowercase
# alpha/digit/dot/underscore matches taskwarrior's attribute-name shape.
_TW_FIELD_RE = re.compile(r'^[a-z][a-z0-9_.]*$')


def tw_modify(uuid, **fields):
    """Safe wrapper around `task <uuid> modify`. Every kwarg becomes one
    `attr:value` argv element; nothing else is ever appended. Returns the
    completed subprocess result (or None for a no-op).

    Why this exists: taskwarrior treats any argv slot after `modify` that
    isn't `attr:value` as a description override — silently replacing
    (or, with mixed args, partially clobbering) the description field.
    Calling `subprocess.run(['task', uuid, 'modify', some_var])` from a
    stale code path then silently destroys the description. This wrapper
    forces every call site to name the field, and argv construction lives
    in one auditable place.

    Pass `None` to skip a field (no-op); pass `''` to clear a tw field
    (taskwarrior's canonical `attr:` empty form). Dynamic field names go
    via `**{name: value}` unpacking."""
    cmd = task_cmd('rc.confirmation:no', uuid, 'modify')
    for key, val in fields.items():
        if not _TW_FIELD_RE.match(key):
            raise ValueError(
                f"tw_modify: refusing key {key!r} — not an attr-shaped name")
        if val is None:
            continue
        cmd.append(f'{key}:{val}')
    if cmd[-1] == 'modify':
        return None
    return subprocess.run(cmd, capture_output=True, text=True, env=task_env())


# ---------- UDA bootstrap ----------

def ensure_uda():
    """Configure the `source` UDA on the embedded backend. Idempotent.
    Silent no-op if the embedded binary isn't installed yet."""
    if not task_installed():
        return
    env = task_env()
    result = subprocess.run(task_cmd('_config'), capture_output=True, text=True, env=env)
    if 'uda.source.type' in (result.stdout or ''):
        return
    subprocess.run(
        task_cmd('rc.confirmation:no', 'config', 'uda.source.type', 'string'),
        capture_output=True, check=True, env=env,
    )
    subprocess.run(
        task_cmd('rc.confirmation:no', 'config', 'uda.source.label', 'Source note'),
        capture_output=True, check=True, env=env,
    )


# ---------- frontmatter parsing ----------

def parse_frontmatter_threads(text):
    """Return the list of thread targets from a file's frontmatter.

    Notes use `threads:` (list of wikilinks); log files use `thread:`
    (singular wikilink). Returns a list of bare targets like
    ['Processes/SGB', 'Projects/AXA DORA']. Empty list if neither
    field is present."""
    lines = text.split('\n')
    if not lines or lines[0].strip() != '---':
        return []
    targets = []
    in_threads_list = False
    for line in lines[1:]:
        if line.strip() == '---':
            break
        if in_threads_list:
            if line.startswith(' ') or line.startswith('\t'):
                stripped = line.lstrip()
                if stripped.startswith('- '):
                    val = stripped[2:].strip().strip('"').strip("'")
                    wm = WIKILINK_RE.match(val)
                    targets.append(wm.group(1).strip() if wm else val)
                continue
            else:
                in_threads_list = False
        if re.match(r'^threads:\s*$', line):
            in_threads_list = True
            continue
        m = re.match(r'^thread:\s*(.+?)\s*$', line)
        if m:
            val = m.group(1).strip().strip('"').strip("'")
            wm = WIKILINK_RE.match(val)
            targets.append(wm.group(1).strip() if wm else val)
    return targets


# Cache built per-invocation by callers that need many lookups.
_threads_cache = None


def build_threads_cache():
    """Walk all source files once, return {source_relpath: [threads]}."""
    cache = {}
    for f in discover_source_files():
        text = f.read_text(encoding='utf-8')
        threads = parse_frontmatter_threads(text)
        rel = str(f.relative_to(HOME).with_suffix(''))
        cache[rel] = threads
    return cache


def threads_for_task(task, cache):
    """Look up thread list for a task via its source UDA. Returns
    a list of bare targets, possibly empty."""
    src = task.get('source', '')
    if not src:
        return []
    return cache.get(src, [])


def find_task_anchors():
    """Walk all source files; yield (uuid8, source_relpath, kind, body).

    kind is 'TASK' (pending) or 'DONE' (completed). source_relpath matches
    the `source` UDA convention (relative to HOME, no .md). body is the
    text between the kind prefix and the uuid anchor — what should match
    the tw `description` field under source-wins. Used by `tasks rebuild`
    to reconcile tw state against source-of-truth anchors."""
    for f in discover_source_files():
        text = f.read_text(encoding='utf-8')
        rel = source_for(f)
        for m in TASK_ANCHOR_RE.finditer(text):
            yield m.group(3), rel, m.group(1), m.group(2).strip()


def load_all_tw_tasks():
    """Export every backend task (all statuses) as a uuid8 -> task dict."""
    require_task()
    result = subprocess.run(task_cmd('rc.confirmation:no', 'export'),
                            capture_output=True, text=True, env=task_env())
    if result.returncode != 0:
        die(f"backend export failed: {(result.stderr or '').strip()}")
    try:
        data = json.loads(result.stdout) if result.stdout.strip() else []
    except json.JSONDecodeError as e:
        die(f"failed to parse backend export: {e}")
    out = {}
    for t in data:
        uuid = t.get('uuid', '')
        if uuid:
            out[uuid[:8]] = t
    return out


def find_action_lines(note_path):
    text = note_path.read_text(encoding='utf-8')
    for idx, line in enumerate(text.split('\n'), start=1):
        m = ACTION_RE.match(line)
        if m:
            assignee = (m.group(1) or '').strip()
            description = m.group(2).strip()
            attr_block = (m.group(3) or '').strip()
            yield idx, line, assignee, description, attr_block


# ---------- ingest ----------

def rewrite_action_to_task(note_path, line_no, uuid_prefix=''):
    """Rewrite source line `ACTION: <body> [<!--attrs-->]` to
    `TASK: <body> <!--<uuid8>-->`. The attrs comment (if any) is dropped
    — those attributes were already applied to the tw task at create
    time and engine-plane state lives in tw from here on."""
    lines = note_path.read_text(encoding='utf-8').split('\n')
    idx = line_no - 1
    if idx < 0 or idx >= len(lines) or not lines[idx].startswith('ACTION:'):
        return False
    line = lines[idx]
    # Strip trailing HTML comment (the attrs block) so the body is clean.
    line_no_comment = re.sub(r'\s*<!--.*?-->\s*$', '', line)
    body = line_no_comment[len('ACTION:'):].strip()
    if uuid_prefix:
        lines[idx] = f'TASK: {body} <!--{uuid_prefix}-->'
    else:
        lines[idx] = f'TASK: {body}'
    note_path.write_text('\n'.join(lines), encoding='utf-8')
    return True


def parse_action_attrs_for_ingest(block):
    """Parse an ACTION line's HTML-comment attr block. Returns
    (task_args, errors). task_args is a list of `task add`-flavored
    tokens ready to splat into the command. Dates get T12:00:00
    appended to avoid local-vs-UTC date slippage."""
    args = []
    errors = []
    for tok in (block or '').split():
        if not tok:
            continue
        if ':' not in tok:
            errors.append(f"unknown attr token {tok!r}")
            continue
        key, _, val = tok.partition(':')
        if key in ('due', 'scheduled'):
            if not DATE_RE.match(val):
                errors.append(f"{key} must be YYYY-MM-DD; got {val!r}")
                continue
            args.append(f"{key}:{val}T12:00:00")
        elif key == 'priority':
            if val not in ('H', 'M', 'L'):
                errors.append(f"priority must be H, M, or L; got {val!r}")
                continue
            args.append(f"priority:{val}")
        elif key == 'depends':
            if not re.match(r'^[a-f0-9]{8}$', val):
                errors.append(f"depends must be 8 hex chars; got {val!r}")
                continue
            args.append(f"depends:{val}")
        else:
            errors.append(f"unknown attr {key!r}")
    return args, errors


def task_uuid_after_add(stdout):
    """Parse 'Created task N.' from `task add` stdout, resolve to UUID.
    Uses `task <id> export` rather than `_uuid` because the latter is a
    *report*, and reports filter by status — a freshly-created scheduled
    task is in +SCHEDULED state and excluded from the default report."""
    m = re.search(r'Created task (\d+)\.', stdout or '')
    if not m:
        return ''
    result = subprocess.run(task_cmd(m.group(1), 'export'),
                            capture_output=True, text=True, env=task_env())
    if result.returncode != 0 or not result.stdout.strip():
        return ''
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return ''
    if data and isinstance(data, list):
        return data[0].get('uuid', '')
    return ''


def cmd_ingest(args):
    """Returns (succeeded, failed_list)."""
    plan = []
    for note in discover_source_files():
        text = note.read_text(encoding='utf-8')
        threads = parse_frontmatter_threads(text)
        for line_no, _line, assignee, description, attr_block in find_action_lines(note):
            errors = []
            if not description:
                errors.append("missing description")
            if not threads:
                errors.append("note has no threads:")
            else:
                for t in threads:
                    if not thread_resolves(t):
                        errors.append(f"thread {t!r} does not resolve")
            if assignee and not assignee_resolves(assignee):
                errors.append(f"assignee {assignee!r} does not resolve to people/{assignee}.md")
            attr_args, attr_errs = parse_action_attrs_for_ingest(attr_block)
            errors.extend(attr_errs)
            plan.append((note, line_no, assignee, description, attr_args, errors))

    if not plan:
        return 0, []

    if not task_installed():
        print(f"error: embedded backend not installed at {TASK_BIN}; run `tasks install` or remove the ACTION: lines.", file=sys.stderr)
        return 0, [(f"{note}:{ln}", ["embedded backend not installed"]) for note, ln, *_ in plan]

    succeeded = 0
    failed = []
    for note, line_no, assignee, description, attr_args, errors in plan:
        prefix = f"{note}:{line_no}"
        if errors:
            failed.append((prefix, errors))
            continue
        full_desc = f'({assignee}) {description}' if assignee else description
        # No project: thread is derived at query time from the source note's
        # `threads:` frontmatter, which can list multiple threads.
        cmd = task_cmd('add', f'source:{source_for(note)}', *attr_args, full_desc)
        if args.dry_run:
            if not args.quiet:
                print(f"would: {' '.join(repr(a) if ' ' in a else a for a in cmd)}")
            continue
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True, env=task_env())
        except subprocess.CalledProcessError as e:
            failed.append((prefix, [f"backend add failed: {e.stderr.strip() or e.stdout.strip()}"]))
            continue
        uuid_prefix = task_uuid_after_add(result.stdout)[:8]
        if not uuid_prefix:
            # Refuse to rewrite the source line without an anchor — an
            # unanchored TASK: leaves the tw record unreachable from any
            # source-driven operation (rebuild, sync, set-description).
            # Leave ACTION: in place so the next ingest re-attempts; the
            # tw task already created is now an orphan that `rebuild`
            # will surface for manual cleanup.
            failed.append((prefix, [
                "could not resolve uuid after backend add; source left as "
                "ACTION: (backend record now orphaned, see `tasks rebuild`)"]))
            continue
        rewrite_action_to_task(note, line_no, uuid_prefix)
        succeeded += 1
        if not args.quiet:
            short = description[:60] + ('...' if len(description) > 60 else '')
            print(f"ingested: {uuid_prefix}  {prefix}  {short}")
    return succeeded, failed


# ---------- sync (source <-> taskwarrior) ----------

TASK_COMMENT_RE = re.compile(r'^(TASK|DONE):\s+(.+?)\s*<!--([a-f0-9]{8})-->\s*$')


def parse_task_line(line):
    m = TASK_COMMENT_RE.match(line)
    if not m:
        return None
    keyword, body, uuid_prefix = m.group(1), m.group(2).strip(), m.group(3)
    state = 'open' if keyword == 'TASK' else 'done'
    return state, uuid_prefix, body


def rewrite_state_in_line(line, new_state):
    if new_state == 'done':
        return re.sub(r'^TASK:', 'DONE:', line, count=1)
    else:
        return re.sub(r'^DONE:', 'TASK:', line, count=1)


def tw_status_to_state(s):
    if s == 'completed':
        return 'done'
    if s in ('pending', 'waiting', 'recurring'):
        return 'open'
    return None


def cmd_sync(args):
    if not task_installed():
        return 0
    result = subprocess.run(task_cmd('export'), capture_output=True, text=True, env=task_env())
    if result.returncode != 0:
        return 0
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    by_prefix = {t['uuid'][:8]: t for t in tasks if t.get('uuid')}

    desc_updates = 0
    status_updates_to_tw = 0
    status_updates_to_src = 0
    for note in discover_source_files():
        text = note.read_text(encoding='utf-8')
        lines = text.split('\n')
        file_changed = False
        for i, line in enumerate(lines):
            parsed = parse_task_line(line)
            if not parsed:
                continue
            src_state, prefix, src_body = parsed
            t = by_prefix.get(prefix)
            if not t:
                continue
            tw_state = tw_status_to_state(t.get('status'))
            if tw_state is None:
                continue

            if t.get('description', '') != src_body:
                r = tw_modify(t['uuid'], description=src_body)
                if r is not None and r.returncode == 0:
                    desc_updates += 1
                    if not args.quiet:
                        print(f"desc->backend: {note.stem}  #{t.get('id', '?')}  -> {src_body[:60]}")

            if src_state == 'open' and tw_state == 'done':
                lines[i] = rewrite_state_in_line(line, 'done')
                file_changed = True
                status_updates_to_src += 1
                if not args.quiet:
                    print(f"status->src: {note.stem}  #{t.get('id', '?')}  TASK->DONE")
            elif src_state == 'done' and tw_state == 'open':
                try:
                    subprocess.run(task_cmd(t['uuid'], 'done'),
                                   capture_output=True, text=True, check=True, env=task_env())
                    status_updates_to_tw += 1
                    if not args.quiet:
                        print(f"status->backend: {note.stem}  #{t.get('id', '?')}  done")
                except subprocess.CalledProcessError:
                    pass

        if file_changed:
            note.write_text('\n'.join(lines), encoding='utf-8')

    return desc_updates + status_updates_to_tw + status_updates_to_src


# ---------- subcommand: add (delegates to `buffer add-action`) ----------

def cmd_add(args):
    """Capture an action item to the buffer. This is a convenience for
    callers thinking in task-flow; it forwards to `buffer add-action`,
    which is the canonical write path. All validation is done by buffer."""
    cmd = ['buffer', 'add-action', args.thread, args.text]
    if args.due:
        cmd += ['--due', args.due]
    if args.scheduled:
        cmd += ['--scheduled', args.scheduled]
    if args.priority:
        cmd += ['--priority', args.priority]
    for d in (args.depends or []):
        cmd += ['--depends', d]
    return subprocess.run(cmd).returncode


# ---------- subcommand helpers: source-line locator ----------

def find_source_line_by_uuid(uuid_prefix):
    """Walk notes/ and logs/, return (path, line_index, parsed) for the
    first TASK/DONE line whose anchor matches the 8-char uuid prefix."""
    short = uuid_prefix[:8]
    for note in discover_source_files():
        lines = note.read_text(encoding='utf-8').split('\n')
        for i, line in enumerate(lines):
            parsed = parse_task_line(line)
            if parsed and parsed[1] == short:
                return note, i, parsed
    return None


def resolve_full_uuid(uuid_prefix):
    """Resolve any prefix to the full UUID via taskwarrior. Errors out if
    not unique or not found. taskwarrior accepts a UUID prefix as a leading
    positional filter and matches across all statuses (incl completed)."""
    require_task()
    result = subprocess.run(task_cmd(uuid_prefix, 'export'),
                            capture_output=True, text=True, env=task_env())
    if result.returncode != 0:
        die(f"backend export failed: {result.stderr.strip() or result.stdout.strip()}")
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    if not tasks:
        die(f"no task found with uuid prefix {uuid_prefix!r}")
    # Filter to exact-prefix matches in case taskwarrior returned more.
    tasks = [t for t in tasks if (t.get('uuid') or '').startswith(uuid_prefix)]
    if not tasks:
        die(f"no task found with uuid prefix {uuid_prefix!r}")
    if len(tasks) > 1:
        die(f"uuid prefix {uuid_prefix!r} is ambiguous ({len(tasks)} matches)")
    return tasks[0]['uuid']


# ---------- subcommand: done ----------

def cmd_done(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    located = find_source_line_by_uuid(full_uuid[:8])
    if located:
        note, idx, parsed = located
        if parsed[0] == 'open':
            lines = note.read_text(encoding='utf-8').split('\n')
            lines[idx] = rewrite_state_in_line(lines[idx], 'done')
            note.write_text('\n'.join(lines), encoding='utf-8')
            print(f"source: {note.stem}:{idx + 1}  TASK -> DONE")
    try:
        subprocess.run(task_cmd(full_uuid, 'done'),
                       capture_output=True, text=True, check=True, env=task_env())
    except subprocess.CalledProcessError as e:
        # backend already-done is fine; otherwise propagate
        msg = (e.stderr or e.stdout or '').strip()
        if 'already' not in msg.lower():
            die(f"backend done failed: {msg}")
    print(f"backend: {full_uuid[:8]} marked done")
    return 0


# ---------- subcommand: set-description ----------

def cmd_set_description(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    new_text = args.text.strip()
    if not new_text:
        die("description is empty")

    located = find_source_line_by_uuid(full_uuid[:8])
    if located:
        note, idx, parsed = located
        state = parsed[0]
        keyword = 'TASK' if state == 'open' else 'DONE'
        lines = note.read_text(encoding='utf-8').split('\n')
        lines[idx] = f"{keyword}: {new_text} <!--{full_uuid[:8]}-->"
        note.write_text('\n'.join(lines), encoding='utf-8')
        print(f"source: {note.stem}:{idx + 1}  -> {new_text[:60]}")
    else:
        print(f"warn: no anchored source line for {full_uuid[:8]}; updating backend only", file=sys.stderr)

    r = tw_modify(full_uuid, description=new_text)
    if r is None or r.returncode != 0:
        die(f"task modify failed: {((r.stderr or r.stdout) if r else '').strip()}")
    print(f"backend: {full_uuid[:8]} description updated")
    return 0


# ---------- subcommand: set-assignee ----------

def cmd_set_assignee(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    person = args.person.strip()
    # Accept either bare name or wikilink-style 'people/<Name>'.
    if person.startswith('people/'):
        person = person[len('people/'):]
    if not assignee_resolves(person):
        die(f"person {person!r} does not resolve to people/{person}.md")

    located = find_source_line_by_uuid(full_uuid[:8])
    if not located:
        die(f"no anchored source line for {full_uuid[:8]} — can't reassign without source")

    note, idx, parsed = located
    state, uuid_prefix, body = parsed
    keyword = 'TASK' if state == 'open' else 'DONE'

    am = ASSIGNEE_PREFIX_RE.match(body)
    naked_body = am.group(2).strip() if am else body
    new_body = f"({person}) {naked_body}"

    lines = note.read_text(encoding='utf-8').split('\n')
    lines[idx] = f"{keyword}: {new_body} <!--{uuid_prefix}-->"
    note.write_text('\n'.join(lines), encoding='utf-8')
    print(f"source: {note.stem}:{idx + 1}  -> {new_body[:60]}")

    r = tw_modify(full_uuid, description=new_body)
    if r is None or r.returncode != 0:
        die(f"task modify failed: {((r.stderr or r.stdout) if r else '').strip()}")
    print(f"backend: {full_uuid[:8]} description updated")
    return 0


# ---------- subcommand: set-due / set-scheduled ----------

def _set_date_field(uuid_arg, date_str, field):
    require_task()
    try:
        date_str = validate_date(date_str)
    except ValueError as e:
        die(str(e))
    full_uuid = resolve_full_uuid(uuid_arg)
    # Append noon so taskwarrior stores the date with enough headroom that
    # both sides of any reasonable TZ conversion stay on the same calendar
    # day. Bare YYYY-MM-DD parses as local midnight and slips a day in UTC.
    r = tw_modify(full_uuid, **{field: f'{date_str}T12:00:00'})
    if r is None or r.returncode != 0:
        die(f"task modify failed: {((r.stderr or r.stdout) if r else '').strip()}")
    print(f"backend: {full_uuid[:8]} {field}:{date_str}")
    return 0


def cmd_set_due(args):
    return _set_date_field(args.uuid, args.date, 'due')


def cmd_set_scheduled(args):
    return _set_date_field(args.uuid, args.date, 'scheduled')


