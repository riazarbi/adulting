def cmd_rm_depends(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    dep_uuid = resolve_full_uuid(args.dep_uuid)
    # taskwarrior uses `depends:-<uuid>` to remove a dependency. The leading
    # '-' is part of the value, not a flag — tw_modify passes it through.
    r = tw_modify(full_uuid, depends=f'-{dep_uuid}')
    if r is None or r.returncode != 0:
        die(f"task modify failed: {((r.stderr or r.stdout) if r else '').strip()}")
    print(f"backend: {full_uuid[:8]} no longer depends on {dep_uuid[:8]}")
    return 0


# ---------- subcommand: list / next / show ----------

def fmt_tw_date(s):
    """taskwarrior emits dates as compact ISO `20260512T120000Z`. Render as
    YYYY-MM-DD."""
    if not s:
        return ''
    if len(s) >= 8 and 'T' in s:
        return f"{s[0:4]}-{s[4:6]}-{s[6:8]}"
    return s[:10]


def _export_filtered(filter_args):
    require_task()
    cmd = task_cmd(*filter_args, 'status:pending', 'export')
    result = subprocess.run(cmd, capture_output=True, text=True, env=task_env())
    if result.returncode != 0:
        die(f"backend export failed: {result.stderr.strip()}")
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    return tasks


def _filter_by_thread(tasks, thread, cache):
    """Keep tasks whose source note's threads list includes `thread`."""
    return [t for t in tasks if thread in threads_for_task(t, cache)]


def _format_threads(threads):
    if not threads:
        return '-'
    if len(threads) == 1:
        return threads[0]
    return f"{threads[0]} +{len(threads) - 1}"


def _print_table(tasks, cache):
    if not tasks:
        print("(no tasks)")
        return
    tasks = sorted(tasks, key=lambda t: t.get('urgency', 0), reverse=True)
    rows = []
    for t in tasks:
        prio = t.get('priority', '')
        prio_cell = f"[{prio}]" if prio else "   "
        uuid8 = (t.get('uuid') or '')[:8]
        thread_cell = _format_threads(threads_for_task(t, cache))
        desc = t.get('description', '')
        due = fmt_tw_date(t.get('due', ''))
        cells = [uuid8, prio_cell, thread_cell, desc, f"due:{due}" if due else '']
        rows.append(cells)

    widths = [max(len(r[c]) for r in rows) for c in range(len(rows[0]))]
    for r in rows:
        print('  '.join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_list(args):
    tasks = _export_filtered(args.filter)
    cache = build_threads_cache()
    if args.thread:
        tasks = _filter_by_thread(tasks, args.thread, cache)
    _print_table(tasks, cache)
    return 0


def cmd_next(args):
    tasks = _export_filtered([])
    cache = build_threads_cache()
    tasks = sorted(tasks, key=lambda t: t.get('urgency', 0), reverse=True)[:5]
    _print_table(tasks, cache)
    return 0


def cmd_show(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    result = subprocess.run(task_cmd(full_uuid, 'export'),
                            capture_output=True, text=True, env=task_env())
    if result.returncode != 0:
        die(f"backend export failed: {result.stderr.strip()}")
    data = json.loads(result.stdout) if result.stdout.strip() else []
    if not data:
        die(f"no task with uuid {full_uuid}")
    t = data[0]
    cache = build_threads_cache()
    threads = threads_for_task(t, cache)
    print(f"uuid:        {t['uuid']}  ({t['uuid'][:8]})")
    print(f"id:          {t.get('id', '-')}")
    print(f"status:      {t.get('status', '-')}")
    print(f"priority:    {t.get('priority', '-')}")
    print(f"threads:     {', '.join(threads) if threads else '-'}")
    print(f"source:      {t.get('source', '-')}")
    print(f"description: {t.get('description', '')}")
    print(f"due:         {fmt_tw_date(t.get('due', ''))}")
    print(f"scheduled:   {fmt_tw_date(t.get('scheduled', ''))}")
    deps = t.get('depends', '')
    if isinstance(deps, list):
        deps = ','.join(deps)
    if deps:
        dep_prefixes = ' '.join(d[:8] for d in deps.split(',') if d)
        print(f"depends:     {dep_prefixes}")
    print(f"entry:       {fmt_tw_date(t.get('entry', ''))}")
    print(f"urgency:     {t.get('urgency', '-')}")
    return 0


def cmd_rebuild(args):
    """Reconcile tw state with source-of-truth (TASK/DONE anchors).

    Dry-run by default. Pass --apply to write; a full `task export` backup
    is written to ~/.adulting/.tasks-backup-<ts>.json before any mutation.

    Three change categories, ordered by risk:

      [source]      Update the `source` UDA when the anchor's current file
                    path differs from what tw recorded at ingest. Safe;
                    heals drift from external file renames.

      [status]      Bring tw status into line with source kind:
                      TASK in source, completed in tw -> reopen
                      DONE in source, pending in tw   -> complete
                    Skips tw tasks in `recurring`, `waiting`, or `deleted`
                    states (surfaces as warnings instead).

      [description] Bring tw description into line with the source line
                    body (assignee prefix included). Highest surprise
                    potential: if a tw description was edited out-of-band
                    and source wasn't, this REVERTS to source. Inspect
                    the dry-run diff carefully.

    Orphans are surfaced as warnings only:
      - anchor in source with no matching tw record
      - tw record with no matching anchor in any source file
    They are left alone (separate, riskier operations)."""
    require_task()

    tw_tasks = load_all_tw_tasks()

    anchors_by_uuid = {}
    for uuid8, rel, kind, body in find_task_anchors():
        anchors_by_uuid.setdefault(uuid8, []).append((rel, kind, body))

    changes = []   # (uuid8, field, old, new)
    warnings = []

    for uuid8, hits in sorted(anchors_by_uuid.items()):
        if len(hits) > 1:
            paths = ', '.join(p for p, _, _ in hits)
            warnings.append(f"{uuid8}: multiple anchors at {paths} (skipped)")
            continue
        new_source, kind, body = hits[0]
        tw = tw_tasks.get(uuid8)
        if tw is None:
            warnings.append(f"{uuid8}: anchor at {new_source!r} but no backend record")
            continue

        old_source = tw.get('source', '')
        if old_source != new_source:
            changes.append((uuid8, 'source', old_source, new_source))

        tw_status = tw.get('status', '')
        if tw_status in ('recurring', 'waiting', 'deleted'):
            warnings.append(
                f"{uuid8}: backend status {tw_status!r} not reconciled "
                f"(source kind: {kind})")
        else:
            want_status = 'pending' if kind == 'TASK' else 'completed'
            if tw_status != want_status:
                changes.append((uuid8, 'status', tw_status, want_status))

        old_desc = tw.get('description', '')
        if old_desc != body:
            changes.append((uuid8, 'description', old_desc, body))

    for u in sorted(tw_tasks):
        if u in anchors_by_uuid:
            continue
        status = tw_tasks[u].get('status', '?')
        warnings.append(f"{u}: in backend ({status}) but no source anchor")

    if args.only:
        before = len(changes)
        changes = [c for c in changes if c[1] in args.only]
        dropped = before - len(changes)
        if dropped:
            print(f"(--only {','.join(args.only)} filtered "
                  f"out {dropped} change(s) in other categories)")

    print(f"rebuild: {len(anchors_by_uuid)} source anchor(s), "
          f"{len(tw_tasks)} tw task(s)")

    if warnings:
        print(f"\n{len(warnings)} warning(s):")
        for w in warnings:
            print(f"  {w}")

    if not changes:
        print("\nNo changes proposed.")
        return 0

    by_cat = {}
    for uuid8, field, old, new in changes:
        by_cat.setdefault(field, []).append((uuid8, old, new))

    print(f"\nProposed changes ({len(changes)}):")
    for cat in sorted(by_cat):
        items = by_cat[cat]
        print(f"\n[{cat}] {len(items)}:")
        for uuid8, old, new in items:
            print(f"  {uuid8}: {old!r} -> {new!r}")

    if not args.apply:
        print("\nDry run. Re-run with --apply to write.")
        return 0

    ts = datetime.now().strftime('%Y%m%d-%H%M%S')
    backup_path = HOME / f'.tasks-backup-{ts}.json'
    bk = subprocess.run(task_cmd('rc.confirmation:no', 'export'),
                        capture_output=True, text=True, env=task_env())
    if bk.returncode != 0:
        die(f"backup export failed: {(bk.stderr or '').strip()}")
    backup_path.write_text(bk.stdout, encoding='utf-8')
    print(f"\nBackup: {backup_path}")

    applied = 0
    failed = []
    for uuid8, field, _old, new in changes:
        full_uuid = tw_tasks[uuid8].get('uuid', '')
        if not full_uuid:
            failed.append((uuid8, field, "missing full uuid in tw export"))
            continue
        if field == 'source':
            r = tw_modify(full_uuid, source=new)
        elif field == 'status':
            if new == 'completed':
                # `done` rather than `modify status:completed` so the
                # backend stamps `end:<now>` itself.
                r = subprocess.run(
                    task_cmd('rc.confirmation:no', full_uuid, 'done'),
                    capture_output=True, text=True, env=task_env())
            elif new == 'pending':
                # Clear end: alongside the status change so the task isn't
                # shown as historically completed-but-pending.
                r = tw_modify(full_uuid, status='pending', end='')
            else:
                failed.append((uuid8, field, f"unhandled status {new!r}"))
                continue
        elif field == 'description':
            r = tw_modify(full_uuid, description=new)
        else:
            failed.append((uuid8, field, f"unknown field {field!r}"))
            continue
        if r is not None and r.returncode == 0:
            applied += 1
        else:
            err = ((r.stderr or r.stdout) if r else '').strip()
            failed.append((uuid8, field, err or "no-op (all fields cleared)"))

    print(f"Applied {applied}/{len(changes)} change(s).")
    if failed:
        print(f"\n{len(failed)} failure(s):", file=sys.stderr)
        for uuid8, field, err in failed:
            print(f"  {uuid8} ({field}): {err}", file=sys.stderr)
        return 1
    return 0


# ---------- subcommand: install ----------

def cmd_install(args):
    """One-shot setup of the embedded backend under ADULTING_HOME/.adulting/.

    Workflow:
      1. Locate a source binary (--from-path, else `task` on PATH, else error).
      2. Copy it to <ADULTING_HOME>/.adulting/bin/task (skips if present
         unless --force).
      3. Create <ADULTING_HOME>/.adulting/task-data and the rcfile.
      4. With --migrate, copy ~/.task/* into task-data (backs up any
         existing task-data contents first).
      5. Apply the source-UDA config on the new install.

    Never deletes from ~/.task; migration is copy-only."""
    src = args.from_path or shutil.which('task')
    if not src:
        die("no `task` binary found on PATH and no --from-path given; "
            "install one (e.g. `brew install task`) then rerun, "
            "or pass --from-path <binary>")
    src_path = Path(src).resolve()  # follow symlinks (brew uses one)
    if not src_path.is_file():
        die(f"source binary {src_path} does not exist or is not a regular file")

    if TASK_BIN.exists() and not args.force:
        die(f"{TASK_BIN} already exists; pass --force to overwrite")

    TASK_BIN.parent.mkdir(parents=True, exist_ok=True)
    TASK_DATA.mkdir(parents=True, exist_ok=True)

    shutil.copy2(src_path, TASK_BIN)
    TASK_BIN.chmod(0o755)
    print(f"binary: {src_path} -> {TASK_BIN}")

    # Minimal rcfile. data.location duplicates the TASKDATA env var so
    # any direct invocation of the embedded binary (without our env)
    # still lands in the private dir.
    if not TASK_RC.exists() or args.force:
        TASK_RC.write_text(f"data.location={TASK_DATA}\nconfirmation=no\n")
        print(f"rc:     {TASK_RC}")

    if args.migrate:
        src_data = Path.home() / '.task'
        if not src_data.is_dir():
            print(f"migrate: no data at {src_data}; skipping")
        else:
            # Back up any existing contents of TASK_DATA before overwriting.
            existing = [p for p in TASK_DATA.iterdir()] if TASK_DATA.exists() else []
            if existing:
                ts = datetime.now().strftime('%Y%m%d-%H%M%S')
                bkp = TASK_DATA.with_name(f'task-data.backup-{ts}')
                shutil.move(str(TASK_DATA), str(bkp))
                TASK_DATA.mkdir(parents=True)
                print(f"migrate: backed up existing task-data -> {bkp}")
            for item in src_data.iterdir():
                dst = TASK_DATA / item.name
                if item.is_dir():
                    shutil.copytree(item, dst)
                else:
                    shutil.copy2(item, dst)
            print(f"migrate: {src_data} -> {TASK_DATA} (source left in place)")

    ensure_uda()
    print(f"data:   {TASK_DATA}")
    print("done.")
    return 0


# ---------- subcommand: migrate-layout ----------

def cmd_migrate_layout(args):
    """One-shot relocation of operational state into <ADULTING_HOME>/.adulting/.

    Old layout had bin/, task-data/, taskrc, config.yaml at the top level,
    cluttering the Obsidian sidebar and Finder view. New layout tucks them
    into a hidden subdir so only user content (notes/, threads/, people/,
    logs/, buffer.md) remains visible.

    Safety:
      - Tarball backup of the whole ADULTING_HOME is written outside the
        directory before anything moves. Refuses to proceed without it.
      - Uses mv (atomic per-file on same FS) rather than copy + verify +
        delete; the tarball is the recovery path if anything goes wrong.
      - --dry-run prints the planned moves without touching anything.
      - Refuses to overwrite items that already exist in the new layout."""

    legacy_items = [
        (_LEGACY_TASK_BIN.parent, INTERNAL_DIR / 'bin', 'dir',
         lambda: _LEGACY_TASK_BIN.exists()),
        (_LEGACY_TASK_DATA, TASK_DATA, 'dir',
         lambda: _LEGACY_TASK_DATA.exists()),
        (_LEGACY_TASK_RC, TASK_RC, 'file',
         lambda: _LEGACY_TASK_RC.exists()),
        (_LEGACY_CONFIG_FILE, CONFIG_FILE, 'file',
         lambda: _LEGACY_CONFIG_FILE.exists()),
    ]
    plan = [(s, d, k) for s, d, k, present in legacy_items if present()]

    cruft_dir = HOME / 'config'
    cruft_present = cruft_dir.is_dir()

    if not plan and not cruft_present:
        if INTERNAL_DIR.exists() and TASK_BIN.exists():
            print("already migrated; nothing to do.")
            return 0
        die("no legacy layout detected and embedded backend not installed; "
            "run `tasks install` first")

    print(f"ADULTING_HOME: {HOME}")
    print(f"Target subdir: {INTERNAL_DIR}")
    print()
    print("Planned moves:")
    for src, dst, kind in plan:
        print(f"  [{kind}] {src} -> {dst}")
    if cruft_present:
        print(f"  [del] {cruft_dir} (cruft from abandoned ask.toml feature)")

    if args.dry_run:
        print("\nDry run. Re-run without --dry-run to apply.")
        return 0

    # ------ pre-flight: nothing in the way ------
    for src, dst, _kind in plan:
        if dst.exists():
            die(f"refusing to overwrite existing {dst}")

    # ------ tarball backup (outside HOME so a botched migration can't eat it) ------
    ts = datetime.now().strftime('%Y%m%d-%H%M%S')
    backup_path = HOME.parent / f'{HOME.name}.backup-{ts}.tar.gz'
    print(f"\nBacking up: {HOME} -> {backup_path}")
    bk = subprocess.run(
        ['tar', '-czf', str(backup_path), '-C', str(HOME.parent), HOME.name],
        capture_output=True, text=True)
    if bk.returncode != 0:
        die(f"tarball backup failed: {(bk.stderr or '').strip()}")
    if not backup_path.exists() or backup_path.stat().st_size < 1024:
        die(f"backup tarball suspiciously small or missing; aborting")
    print(f"backup: {backup_path} ({backup_path.stat().st_size:,} bytes)")

    # ------ moves ------
    INTERNAL_DIR.mkdir(parents=True, exist_ok=True)
    for src, dst, _kind in plan:
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(src), str(dst))
        print(f"moved: {src} -> {dst}")

    # ------ delete cruft ------
    if cruft_present:
        shutil.rmtree(cruft_dir)
        print(f"deleted: {cruft_dir}")

    # ------ regenerate taskrc absolute paths ------
    if TASK_RC.exists():
        # The old rcfile pinned data.location at the old absolute path; the
        # backend would still find the data via TASKDATA env var, but a
        # direct invocation of the binary (without our env) would land on a
        # ghost path. Rewrite to canonicalize.
        TASK_RC.write_text(f"data.location={TASK_DATA}\nconfirmation=no\n")
        print(f"regenerated: {TASK_RC}")
        # Re-apply UDA config (the previous rcfile had uda.source.* lines
        # that we just truncated; ensure_uda detects this and re-adds them).
        ensure_uda()

    print()
    print("done. To roll back:")
    print(f"  rm -rf {HOME}")
    print(f"  tar -xzf {backup_path} -C {HOME.parent}")
    return 0


# ---------- main ----------

def cmd_default(args):
    """No subcommand: ingest + sync. Used as the pre-pass by `notes`."""
    succeeded, failed = cmd_ingest(args)
    if not args.dry_run:
        cmd_sync(args)
    if failed:
        print()
        print(f"{len(failed)} action(s) NOT ingested (left as ACTION: in source):", file=sys.stderr)
        for prefix, errs in failed:
            for e in errs:
                print(f"  {prefix}: {e}", file=sys.stderr)
        print()
    if not args.quiet:
        if succeeded or failed:
            print(f"Ingested: {succeeded}.  Failed: {len(failed)}.")
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(
        description="Bridge ACTION lines into the task backend; surface ops as subcommands.")
    parser.add_argument('--dry-run', action='store_true',
                        help="(default invocation only) Show what would be ingested.")
    parser.add_argument('--quiet', action='store_true',
                        help="(default invocation only) Suppress per-action output.")
    sub = parser.add_subparsers(dest='subcommand')

    p_add = sub.add_parser('add', help="Buffer-append a structured ACTION (delegates to `buffer add-action`).")
    p_add.add_argument('thread', help="Thread label like 'Projects/SGB'.")
    p_add.add_argument('text', help="'(Assignee) description' or just 'description'.")
    p_add.add_argument('--due', help='YYYY-MM-DD due date applied at ingest.')
    p_add.add_argument('--scheduled', help='YYYY-MM-DD scheduled date.')
    p_add.add_argument('--priority', choices=['H', 'M', 'L'])
    p_add.add_argument('--depends', action='append', default=[],
                       help='8-char UUID prefix; repeatable for multiple deps.')
    p_add.set_defaults(func=cmd_add)

    p_done = sub.add_parser('done', help="Mark a task complete (source + backend).")
    p_done.add_argument('uuid')
    p_done.set_defaults(func=cmd_done)

    p_sd = sub.add_parser('set-description', help="Rewrite source body and backend description.")
    p_sd.add_argument('uuid')
    p_sd.add_argument('text')
    p_sd.set_defaults(func=cmd_set_description)

    p_sa = sub.add_parser('set-assignee', help="Rewrite the (Assignee) prefix.")
    p_sa.add_argument('uuid')
    p_sa.add_argument('person')
    p_sa.set_defaults(func=cmd_set_assignee)

    p_sdue = sub.add_parser('set-due', help="Set due date (YYYY-MM-DD).")
    p_sdue.add_argument('uuid')
    p_sdue.add_argument('date')
    p_sdue.set_defaults(func=cmd_set_due)

    p_ssch = sub.add_parser('set-scheduled', help="Set scheduled date (YYYY-MM-DD).")
    p_ssch.add_argument('uuid')
    p_ssch.add_argument('date')
    p_ssch.set_defaults(func=cmd_set_scheduled)

    p_sp = sub.add_parser('set-priority', help="Set priority H|M|L.")
    p_sp.add_argument('uuid')
    p_sp.add_argument('priority')
    p_sp.set_defaults(func=cmd_set_priority)

    p_ad = sub.add_parser('add-depends', help="Add a depends entry.")
    p_ad.add_argument('uuid')
    p_ad.add_argument('dep_uuid', metavar='dep-uuid')
    p_ad.set_defaults(func=cmd_add_depends)

