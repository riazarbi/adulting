    p_rd.add_argument('uuid')
    p_rd.add_argument('dep_uuid', metavar='dep-uuid')
    p_rd.set_defaults(func=cmd_rm_depends)

    p_list = sub.add_parser('list', help="List pending tasks (formatted).")
    p_list.add_argument('filter', nargs='*', help="Optional backend filter args.")
    p_list.add_argument('--thread', help="Filter to tasks whose source note has this thread (e.g. Processes/SGB).")
    p_list.set_defaults(func=cmd_list)

    p_next = sub.add_parser('next', help="Top 5 pending tasks by urgency.")
    p_next.set_defaults(func=cmd_next)

    p_show = sub.add_parser('show', help="Detail view of one task.")
    p_show.add_argument('uuid')
    p_show.set_defaults(func=cmd_show)

    p_rebuild = sub.add_parser(
        'rebuild',
        help="Reconcile backend state with source-of-truth anchors. Dry-run by default.")
    p_rebuild.add_argument(
        '--apply', action='store_true',
        help="Write changes to the backend (backup is taken first).")
    p_rebuild.add_argument(
        '--only', choices=['source', 'status', 'description'],
        action='append', default=[],
        help="Limit to one or more change categories (repeatable). "
             "Omit to include all.")
    p_rebuild.set_defaults(func=cmd_rebuild)

    p_install = sub.add_parser(
        'install',
