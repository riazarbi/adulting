def cmd_add_depends(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    dep_uuid = resolve_full_uuid(args.dep_uuid)
    if dep_uuid == full_uuid:
        die("a task cannot depend on itself")
    r = tw_modify(full_uuid, depends=dep_uuid)
    if r is None or r.returncode != 0:
        die(f"task modify failed: {((r.stderr or r.stdout) if r else '').strip()}")
