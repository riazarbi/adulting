#!/usr/bin/env python3
"""Bridge ACTION: lines from notes into taskwarrior; keep source TASK:/DONE:
lines in sync with taskwarrior state. Surface taskwarrior operations as
opinionated subcommands so taskwarrior itself stays an internal backend.

No-arg invocation (used as a pre-pass by `notes`):
  1. Configure the `source` UDA in taskwarrior if not already (idempotent).
  2. Ingest ACTION: lines from notes into taskwarrior, anchoring the source
     line back with an 8-char UUID HTML comment.
  3. Sync source <-> taskwarrior:
     - Description drift (source body != tw description): source wins.
     - Status drift: completed-state-wins.

Subcommands:
  add <thread> <text>            buffer-append a structured ACTION
  done <uuid>                    flip source TASK->DONE; tw -> done
  set-description <uuid> <text>  rewrite source body; sync pushes to tw
  set-assignee <uuid> <person>   rewrite source (Asg) prefix
  set-due <uuid> <YYYY-MM-DD>    set tw due
  set-scheduled <uuid> <YYYY-MM-DD>  set tw scheduled
  set-priority <uuid> <H|M|L>    set tw priority
  add-depends <uuid> <dep>       add tw depends entry
  rm-depends <uuid> <dep>        remove tw depends entry
  list [filter...]               formatted list with UUID prefix
  next                           top of queue
  show <uuid>                    detail view

`task` must be on PATH for any operation that touches taskwarrior.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

HOME = Path(os.path.expanduser('~/.adulting'))
NOTES_DIR = HOME / 'notes'
THREADS_DIR = HOME / 'threads'
PEOPLE_DIR = HOME / 'people'
BUFFER_FILE = HOME / 'buffer.md'
CONFIG_FILE = HOME / 'config.yaml'

WIKILINK_RE = re.compile(r'\[\[([^\]]+)\]\]')
ACTION_RE = re.compile(r'^ACTION:\s*(?:\(([^)]+)\)\s*)?(.+?)\s*$')
DATE_RE = re.compile(r'^\d{4}-\d{2}-\d{2}$')
ASSIGNEE_PREFIX_RE = re.compile(r'^\(([^)]+)\)\s*(.*)$')


# ---------- helpers ----------

def task_in_path():
    return shutil.which('task') is not None


def require_task():
    if not task_in_path():
        die("'task' (taskwarrior) not in PATH")


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def validate_date(s):
    """Caller-format YYYY-MM-DD. Returns the same string if valid;
    raises ValueError otherwise. taskwarrior accepts this form natively
    so no conversion is needed at the boundary."""
    if not DATE_RE.match(s):
        raise ValueError(f"date must be YYYY-MM-DD, got {s!r}")
    try:
        datetime.strptime(s, '%Y-%m-%d')
    except ValueError as e:
        raise ValueError(f"invalid date {s!r}: {e}")
    return s


def validate_priority(s):
    if s not in ('H', 'M', 'L'):
        raise ValueError(f"priority must be H, M, or L; got {s!r}")
    return s


def assignee_resolves(name):
    if not name:
        return True
    return (PEOPLE_DIR / f"{name}.md").exists()


def thread_resolves(target):
    if not target or '/' not in target:
        return False
    kind_dir, name = target.split('/', 1)
    if kind_dir not in ('Projects', 'Processes', 'Topics'):
        return False
    return (THREADS_DIR / kind_dir / f"{name}.md").exists()


def thread_to_project(target):
    if '/' in target:
        return target.split('/', 1)[1]
    return target


# ---------- UDA bootstrap ----------

def ensure_uda():
    """Configure the `source` UDA in taskwarrior. Idempotent. Silent no-op
    if `task` is missing."""
    if not task_in_path():
        return
    result = subprocess.run(['task', '_config'], capture_output=True, text=True)
    if 'uda.source.type' in (result.stdout or ''):
        return
    subprocess.run(
        ['task', 'rc.confirmation:no', 'config', 'uda.source.type', 'string'],
        capture_output=True, check=True,
    )
    subprocess.run(
        ['task', 'rc.confirmation:no', 'config', 'uda.source.label', 'Source note'],
        capture_output=True, check=True,
    )


# ---------- frontmatter parsing ----------

def parse_frontmatter_thread(text):
    """Pull the bare wikilink target out of a note's `thread:` field."""
    lines = text.split('\n')
    if not lines or lines[0].strip() != '---':
        return None
    for line in lines[1:]:
        if line.strip() == '---':
            break
        m = re.match(r'^thread:\s*(.+?)\s*$', line)
        if m:
            val = m.group(1).strip().strip('"').strip("'")
            wm = WIKILINK_RE.match(val)
            if wm:
                return wm.group(1).strip()
            return val
    return None


def find_action_lines(note_path):
    text = note_path.read_text(encoding='utf-8')
    for idx, line in enumerate(text.split('\n'), start=1):
        m = ACTION_RE.match(line)
        if m:
            yield idx, line, (m.group(1) or '').strip(), m.group(2).strip()


# ---------- ingest ----------

def rewrite_action_to_task(note_path, line_no, uuid_prefix=''):
    """Rewrite source line `ACTION: <body>` to `TASK: <body> <!--<uuid8>-->`."""
    lines = note_path.read_text(encoding='utf-8').split('\n')
    idx = line_no - 1
    if idx < 0 or idx >= len(lines) or not lines[idx].startswith('ACTION:'):
        return False
    body = lines[idx][len('ACTION:'):].strip()
    if uuid_prefix:
        lines[idx] = f'TASK: {body} <!--{uuid_prefix}-->'
    else:
        lines[idx] = f'TASK: {body}'
    note_path.write_text('\n'.join(lines), encoding='utf-8')
    return True


def task_uuid_after_add(stdout):
    """Parse 'Created task N.' from `task add` stdout, resolve to UUID."""
    m = re.search(r'Created task (\d+)\.', stdout or '')
    if not m:
        return ''
    result = subprocess.run(['task', m.group(1), '_uuid'],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ''


def cmd_ingest(args):
    """Returns (succeeded, failed_list)."""
    if not NOTES_DIR.is_dir():
        return 0, []

    plan = []
    for note in sorted(NOTES_DIR.iterdir()):
        if note.suffix != '.md' or note.name.startswith('.'):
            continue
        text = note.read_text(encoding='utf-8')
        thread_target = parse_frontmatter_thread(text)
        for line_no, _line, assignee, description in find_action_lines(note):
            errors = []
            if not description:
                errors.append("missing description")
            if not thread_target:
                errors.append("note has no thread:")
            elif not thread_resolves(thread_target):
                errors.append(f"thread {thread_target!r} does not resolve")
            if assignee and not assignee_resolves(assignee):
                errors.append(f"assignee {assignee!r} does not resolve to people/{assignee}.md")
            project = thread_to_project(thread_target) if thread_target else None
            plan.append((note, line_no, project, assignee, description, errors))

    if not plan:
        return 0, []

    if not task_in_path():
        print("error: 'task' (taskwarrior) not in PATH; install it or remove the ACTION: lines.", file=sys.stderr)
        return 0, [(f"{note}:{ln}", ["task not in PATH"]) for note, ln, *_ in plan]

    succeeded = 0
    failed = []
    for note, line_no, project, assignee, description, errors in plan:
        prefix = f"{note}:{line_no}"
        if errors:
            failed.append((prefix, errors))
            continue
        full_desc = f'({assignee}) {description}' if assignee else description
        cmd = ['task', 'add', f'project:{project}', f'source:{note.stem}', full_desc]
        if args.dry_run:
            if not args.quiet:
                print(f"would: {' '.join(repr(a) if ' ' in a else a for a in cmd)}")
            continue
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        except subprocess.CalledProcessError as e:
            failed.append((prefix, [f"task add failed: {e.stderr.strip() or e.stdout.strip()}"]))
            continue
        uuid_prefix = task_uuid_after_add(result.stdout)[:8]
        rewrite_action_to_task(note, line_no, uuid_prefix)
        succeeded += 1
        if not args.quiet:
            short = description[:60] + ('...' if len(description) > 60 else '')
            print(f"ingested: {prefix}  project:{project}  {short}")
    return succeeded, failed


# ---------- sync (source <-> taskwarrior) ----------

TASK_COMMENT_RE = re.compile(r'^(TASK|DONE):\s+(.+?)\s*<!--([a-f0-9]{8})-->\s*$')


def parse_task_line(line):
    m = TASK_COMMENT_RE.match(line)
    if not m:
        return None
    keyword, body, uuid_prefix = m.group(1), m.group(2).strip(), m.group(3)
    state = 'open' if keyword == 'TASK' else 'done'
    return state, uuid_prefix, body


def rewrite_state_in_line(line, new_state):
    if new_state == 'done':
        return re.sub(r'^TASK:', 'DONE:', line, count=1)
    else:
        return re.sub(r'^DONE:', 'TASK:', line, count=1)


def tw_status_to_state(s):
    if s == 'completed':
        return 'done'
    if s in ('pending', 'waiting', 'recurring'):
        return 'open'
    return None


def cmd_sync(args):
    if not task_in_path() or not NOTES_DIR.is_dir():
        return 0
    result = subprocess.run(['task', 'export'], capture_output=True, text=True)
    if result.returncode != 0:
        return 0
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    by_prefix = {t['uuid'][:8]: t for t in tasks if t.get('uuid')}

    desc_updates = 0
    status_updates_to_tw = 0
    status_updates_to_src = 0
    for note in sorted(NOTES_DIR.iterdir()):
        if note.suffix != '.md' or note.name.startswith('.'):
            continue
        text = note.read_text(encoding='utf-8')
        lines = text.split('\n')
        file_changed = False
        for i, line in enumerate(lines):
            parsed = parse_task_line(line)
            if not parsed:
                continue
            src_state, prefix, src_body = parsed
            t = by_prefix.get(prefix)
            if not t:
                continue
            tw_state = tw_status_to_state(t.get('status'))
            if tw_state is None:
                continue

            if t.get('description', '') != src_body:
                try:
                    subprocess.run(['task', t['uuid'], 'modify', src_body],
                                   capture_output=True, text=True, check=True)
                    desc_updates += 1
                    if not args.quiet:
                        print(f"desc->tw: {note.stem}  #{t.get('id', '?')}  -> {src_body[:60]}")
                except subprocess.CalledProcessError:
                    pass

            if src_state == 'open' and tw_state == 'done':
                lines[i] = rewrite_state_in_line(line, 'done')
                file_changed = True
                status_updates_to_src += 1
                if not args.quiet:
                    print(f"status->src: {note.stem}  #{t.get('id', '?')}  TASK->DONE")
            elif src_state == 'done' and tw_state == 'open':
                try:
                    subprocess.run(['task', t['uuid'], 'done'],
                                   capture_output=True, text=True, check=True)
                    status_updates_to_tw += 1
                    if not args.quiet:
                        print(f"status->tw: {note.stem}  #{t.get('id', '?')}  done")
                except subprocess.CalledProcessError:
                    pass

        if file_changed:
            note.write_text('\n'.join(lines), encoding='utf-8')

    return desc_updates + status_updates_to_tw + status_updates_to_src


# ---------- subcommand: add (buffer append) ----------

def cmd_add(args):
    """Validate inputs, then append a structured ACTION line to buffer.md.
    Buffer line format:
      - [[<Kind>/<Name>]] ACTION: [(<Person>)] <description> <!--YYYY-MM-DD-->
    """
    thread = args.thread.strip()
    text = args.text.strip()

    if not thread_resolves(thread):
        die(f"thread {thread!r} does not resolve to threads/<Kind>/<Name>.md "
            f"(expected Projects/X, Processes/X, or Topics/X)")

    if not text:
        die("description is empty")

    am = ASSIGNEE_PREFIX_RE.match(text)
    if am:
        assignee = am.group(1).strip()
        body = am.group(2).strip()
        if not body:
            die("description after assignee is empty")
        if not assignee_resolves(assignee):
            die(f"assignee {assignee!r} does not resolve to people/{assignee}.md "
                f"(create the person file first)")
        line_text = f"({assignee}) {body}"
    else:
        line_text = text

    today = datetime.now().strftime('%Y-%m-%d')
    entry = f"- [[{thread}]] ACTION: {line_text} <!--{today}-->\n"

    BUFFER_FILE.parent.mkdir(parents=True, exist_ok=True)
    existing = BUFFER_FILE.read_text(encoding='utf-8') if BUFFER_FILE.exists() else ''
    if existing and not existing.endswith('\n'):
        existing += '\n'
    BUFFER_FILE.write_text(existing + entry, encoding='utf-8')

    print(f"buffered: {entry.rstrip()}")
    return 0


# ---------- subcommand helpers: source-line locator ----------

def find_source_line_by_uuid(uuid_prefix):
    """Walk notes/, return (note_path, line_index, parsed) for the first
    TASK/DONE line whose anchor matches uuid_prefix. Returns None if not
    found. uuid_prefix is matched against the 8-char anchor exactly,
    OR as a startswith (so a longer caller-supplied UUID also matches)."""
    if not NOTES_DIR.is_dir():
        return None
    short = uuid_prefix[:8]
    for note in sorted(NOTES_DIR.iterdir()):
        if note.suffix != '.md' or note.name.startswith('.'):
            continue
        lines = note.read_text(encoding='utf-8').split('\n')
        for i, line in enumerate(lines):
            parsed = parse_task_line(line)
            if parsed and parsed[1] == short:
                return note, i, parsed
    return None


def resolve_full_uuid(uuid_prefix):
    """Resolve any prefix to the full UUID via taskwarrior. Errors out if
    not unique or not found. taskwarrior accepts a UUID prefix as a leading
    positional filter and matches across all statuses (incl completed)."""
    require_task()
    result = subprocess.run(['task', uuid_prefix, 'export'],
                            capture_output=True, text=True)
    if result.returncode != 0:
        die(f"task export failed: {result.stderr.strip() or result.stdout.strip()}")
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    if not tasks:
        die(f"no task found with uuid prefix {uuid_prefix!r}")
    # Filter to exact-prefix matches in case taskwarrior returned more.
    tasks = [t for t in tasks if (t.get('uuid') or '').startswith(uuid_prefix)]
    if not tasks:
        die(f"no task found with uuid prefix {uuid_prefix!r}")
    if len(tasks) > 1:
        die(f"uuid prefix {uuid_prefix!r} is ambiguous ({len(tasks)} matches)")
    return tasks[0]['uuid']


# ---------- subcommand: done ----------

def cmd_done(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    located = find_source_line_by_uuid(full_uuid[:8])
    if located:
        note, idx, parsed = located
        if parsed[0] == 'open':
            lines = note.read_text(encoding='utf-8').split('\n')
            lines[idx] = rewrite_state_in_line(lines[idx], 'done')
            note.write_text('\n'.join(lines), encoding='utf-8')
            print(f"source: {note.stem}:{idx + 1}  TASK -> DONE")
    try:
        subprocess.run(['task', full_uuid, 'done'],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        # taskwarrior already-done is fine; otherwise propagate
        msg = (e.stderr or e.stdout or '').strip()
        if 'already' not in msg.lower():
            die(f"task done failed: {msg}")
    print(f"taskwarrior: {full_uuid[:8]} marked done")
    return 0


# ---------- subcommand: set-description ----------

def cmd_set_description(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    new_text = args.text.strip()
    if not new_text:
        die("description is empty")

    located = find_source_line_by_uuid(full_uuid[:8])
    if located:
        note, idx, parsed = located
        state = parsed[0]
        keyword = 'TASK' if state == 'open' else 'DONE'
        lines = note.read_text(encoding='utf-8').split('\n')
        lines[idx] = f"{keyword}: {new_text} <!--{full_uuid[:8]}-->"
        note.write_text('\n'.join(lines), encoding='utf-8')
        print(f"source: {note.stem}:{idx + 1}  -> {new_text[:60]}")
    else:
        print(f"warn: no anchored source line for {full_uuid[:8]}; updating tw only", file=sys.stderr)

    try:
        subprocess.run(['task', full_uuid, 'modify', new_text],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} description updated")
    return 0


# ---------- subcommand: set-assignee ----------

def cmd_set_assignee(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    person = args.person.strip()
    if not assignee_resolves(person):
        die(f"person {person!r} does not resolve to people/{person}.md")

    located = find_source_line_by_uuid(full_uuid[:8])
    if not located:
        die(f"no anchored source line for {full_uuid[:8]} — can't reassign without source")

    note, idx, parsed = located
    state, uuid_prefix, body = parsed
    keyword = 'TASK' if state == 'open' else 'DONE'

    am = ASSIGNEE_PREFIX_RE.match(body)
    naked_body = am.group(2).strip() if am else body
    new_body = f"({person}) {naked_body}"

    lines = note.read_text(encoding='utf-8').split('\n')
    lines[idx] = f"{keyword}: {new_body} <!--{uuid_prefix}-->"
    note.write_text('\n'.join(lines), encoding='utf-8')
    print(f"source: {note.stem}:{idx + 1}  -> {new_body[:60]}")

    try:
        subprocess.run(['task', full_uuid, 'modify', new_body],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} description updated")
    return 0


# ---------- subcommand: set-due / set-scheduled ----------

def _set_date_field(uuid_arg, date_str, field):
    require_task()
    try:
        date_str = validate_date(date_str)
    except ValueError as e:
        die(str(e))
    full_uuid = resolve_full_uuid(uuid_arg)
    # Append noon so taskwarrior stores the date with enough headroom that
    # both sides of any reasonable TZ conversion stay on the same calendar
    # day. Bare YYYY-MM-DD parses as local midnight and slips a day in UTC.
    try:
        subprocess.run(['task', full_uuid, 'modify', f'{field}:{date_str}T12:00:00'],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} {field}:{date_str}")
    return 0


def cmd_set_due(args):
    return _set_date_field(args.uuid, args.date, 'due')


def cmd_set_scheduled(args):
    return _set_date_field(args.uuid, args.date, 'scheduled')


# ---------- subcommand: set-priority ----------

def cmd_set_priority(args):
    require_task()
    try:
        prio = validate_priority(args.priority)
    except ValueError as e:
        die(str(e))
    full_uuid = resolve_full_uuid(args.uuid)
    try:
        subprocess.run(['task', full_uuid, 'modify', f'priority:{prio}'],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} priority:{prio}")
    return 0


# ---------- subcommand: add-depends / rm-depends ----------

def cmd_add_depends(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    dep_uuid = resolve_full_uuid(args.dep_uuid)
    if dep_uuid == full_uuid:
        die("a task cannot depend on itself")
    try:
        subprocess.run(['task', full_uuid, 'modify', f'depends:{dep_uuid}'],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} now depends on {dep_uuid[:8]}")
    return 0


def cmd_rm_depends(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    dep_uuid = resolve_full_uuid(args.dep_uuid)
    try:
        subprocess.run(['task', full_uuid, 'modify', f'depends:-{dep_uuid}'],
                       capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        die(f"task modify failed: {(e.stderr or e.stdout).strip()}")
    print(f"taskwarrior: {full_uuid[:8]} no longer depends on {dep_uuid[:8]}")
    return 0


# ---------- subcommand: list / next / show ----------

def fmt_tw_date(s):
    """taskwarrior emits dates as compact ISO `20260512T120000Z`. Render as
    YYYY-MM-DD."""
    if not s:
        return ''
    if len(s) >= 8 and 'T' in s:
        return f"{s[0:4]}-{s[4:6]}-{s[6:8]}"
    return s[:10]


def _export_filtered(filter_args):
    require_task()
    cmd = ['task'] + list(filter_args) + ['status:pending', 'export']
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        die(f"task export failed: {result.stderr.strip()}")
    tasks = json.loads(result.stdout) if result.stdout.strip() else []
    return tasks


def _print_table(tasks, show_scheduled=False):
    if not tasks:
        print("(no tasks)")
        return
    # Sort by urgency descending
    tasks = sorted(tasks, key=lambda t: t.get('urgency', 0), reverse=True)
    rows = []
    for t in tasks:
        prio = t.get('priority', '')
        prio_cell = f"[{prio}]" if prio else "   "
        uuid8 = (t.get('uuid') or '')[:8]
        project = t.get('project', '') or '-'
        desc = t.get('description', '')
        if len(desc) > 64:
            desc = desc[:61] + '...'
        due = fmt_tw_date(t.get('due', ''))
        sched = fmt_tw_date(t.get('scheduled', ''))
        source = t.get('source', '')
        cells = [uuid8, prio_cell, project, desc, f"due:{due}" if due else '']
        if show_scheduled:
            cells.append(f"sched:{sched}" if sched else '')
        cells.append(f"src:{source}" if source else '')
        rows.append(cells)

    widths = [max(len(r[c]) for r in rows) for c in range(len(rows[0]))]
    for r in rows:
        print('  '.join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_list(args):
    tasks = _export_filtered(args.filter)
    _print_table(tasks)
    return 0


def cmd_next(args):
    tasks = _export_filtered([])
    tasks = sorted(tasks, key=lambda t: t.get('urgency', 0), reverse=True)[:5]
    _print_table(tasks)
    return 0


def cmd_show(args):
    require_task()
    full_uuid = resolve_full_uuid(args.uuid)
    result = subprocess.run(['task', full_uuid, 'export'],
                            capture_output=True, text=True)
    if result.returncode != 0:
        die(f"task export failed: {result.stderr.strip()}")
    data = json.loads(result.stdout) if result.stdout.strip() else []
    if not data:
        die(f"no task with uuid {full_uuid}")
    t = data[0]
    print(f"uuid:        {t['uuid']}  ({t['uuid'][:8]})")
    print(f"id:          {t.get('id', '-')}")
    print(f"status:      {t.get('status', '-')}")
    print(f"priority:    {t.get('priority', '-')}")
    print(f"project:     {t.get('project', '-')}")
    print(f"source:      {t.get('source', '-')}")
    print(f"description: {t.get('description', '')}")
    print(f"due:         {fmt_tw_date(t.get('due', ''))}")
    print(f"scheduled:   {fmt_tw_date(t.get('scheduled', ''))}")
    deps = t.get('depends', '')
    if isinstance(deps, list):
        deps = ','.join(deps)
    if deps:
        dep_prefixes = ' '.join(d[:8] for d in deps.split(',') if d)
        print(f"depends:     {dep_prefixes}")
    print(f"entry:       {fmt_tw_date(t.get('entry', ''))}")
    print(f"urgency:     {t.get('urgency', '-')}")
    return 0


# ---------- main ----------

def cmd_default(args):
    """No subcommand: ingest + sync. Used as the pre-pass by `notes`."""
    succeeded, failed = cmd_ingest(args)
    if not args.dry_run:
        cmd_sync(args)
    if failed:
        print()
        print(f"{len(failed)} action(s) NOT ingested (left as ACTION: in source):", file=sys.stderr)
        for prefix, errs in failed:
            for e in errs:
                print(f"  {prefix}: {e}", file=sys.stderr)
        print()
    if not args.quiet:
        if succeeded or failed:
            print(f"Ingested: {succeeded}.  Failed: {len(failed)}.")
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(
        description="Bridge ACTION lines to taskwarrior; surface task ops as subcommands.")
    parser.add_argument('--dry-run', action='store_true',
                        help="(default invocation only) Show what would be ingested.")
    parser.add_argument('--quiet', action='store_true',
                        help="(default invocation only) Suppress per-action output.")
    sub = parser.add_subparsers(dest='subcommand')

    p_add = sub.add_parser('add', help="Buffer-append a structured ACTION.")
    p_add.add_argument('thread', help="Thread label like 'Projects/SGB'.")
    p_add.add_argument('text', help="'(Assignee) description' or just 'description'.")
    p_add.set_defaults(func=cmd_add)

    p_done = sub.add_parser('done', help="Mark a task complete (source + tw).")
    p_done.add_argument('uuid')
    p_done.set_defaults(func=cmd_done)

    p_sd = sub.add_parser('set-description', help="Rewrite source body and tw description.")
    p_sd.add_argument('uuid')
    p_sd.add_argument('text')
    p_sd.set_defaults(func=cmd_set_description)

    p_sa = sub.add_parser('set-assignee', help="Rewrite the (Assignee) prefix.")
    p_sa.add_argument('uuid')
    p_sa.add_argument('person')
    p_sa.set_defaults(func=cmd_set_assignee)

    p_sdue = sub.add_parser('set-due', help="Set tw due date (YYYY-MM-DD).")
    p_sdue.add_argument('uuid')
    p_sdue.add_argument('date')
    p_sdue.set_defaults(func=cmd_set_due)

    p_ssch = sub.add_parser('set-scheduled', help="Set tw scheduled date (YYYY-MM-DD).")
    p_ssch.add_argument('uuid')
    p_ssch.add_argument('date')
    p_ssch.set_defaults(func=cmd_set_scheduled)

    p_sp = sub.add_parser('set-priority', help="Set tw priority H|M|L.")
    p_sp.add_argument('uuid')
    p_sp.add_argument('priority')
    p_sp.set_defaults(func=cmd_set_priority)

    p_ad = sub.add_parser('add-depends', help="Add a depends entry on tw.")
    p_ad.add_argument('uuid')
    p_ad.add_argument('dep_uuid', metavar='dep-uuid')
    p_ad.set_defaults(func=cmd_add_depends)

    p_rd = sub.add_parser('rm-depends', help="Remove a depends entry on tw.")
    p_rd.add_argument('uuid')
    p_rd.add_argument('dep_uuid', metavar='dep-uuid')
    p_rd.set_defaults(func=cmd_rm_depends)

    p_list = sub.add_parser('list', help="List pending tasks (formatted).")
    p_list.add_argument('filter', nargs='*', help="Optional taskwarrior filter args.")
    p_list.set_defaults(func=cmd_list)

    p_next = sub.add_parser('next', help="Top 5 pending tasks by urgency.")
    p_next.set_defaults(func=cmd_next)

    p_show = sub.add_parser('show', help="Detail view of one task.")
    p_show.add_argument('uuid')
    p_show.set_defaults(func=cmd_show)

    args = parser.parse_args()

    ensure_uda()

    if args.subcommand is None:
        return cmd_default(args)
    return args.func(args)


if __name__ == '__main__':
    sys.exit(main())
